#!/bin/sh
# Sourced by /bin/init (extras/linux/bin/init) at boot when present.
# /dev/fd is required by bash process substitution (harness uses it); devtmpfs
# mounts /dev at boot without it, so create the symlink here. Then bring up
# guest networking in the background once the v86 relay connects.
ln -sf /proc/self/fd /dev/fd 2>/dev/null
/bin/startnet &
